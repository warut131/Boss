 "chunks": [
  {
   "scene": 1,
   "text": "ตีสาม โทรศัพท์คุณสั่น",
   "style": "n",
   "start": 0.8,
   "end": 2.222
  },
  {
   "scene": 1,
   "text": "ข้อความจากเบอร์… ของคุณเอง",
   "style": "r",
   "start": 2.772,
   "end": 5.464
  },
  {
   "scene": 2,
   "text": "อย่าเปิดไฟ",
   "style": "y",
   "start": 6.664,
   "end": 7.375
  },
  {
   "scene": 3,
   "text": "คุณขำ คิดว่าเพื่อนแกล้ง",
   "style": "n",
   "start": 8.675,
   "end": 10.126
  },
  {
   "scene": 4,
   "text": "ข้อความที่สองเด้งขึ้นมา",
   "style": "n",
   "start": 10.926,
   "end": 12.547
  },
  {
   "scene": 4,
   "text": "มันอยู่ใต้เตียง รอให้คุณเปิดไฟ",
   "style": "r",
   "start": 13.097,
   "end": 14.995
  },
  {
   "scene": 5,
   "text": "แกรก… แกรก…",
   "style": "k",
   "sfx": "squeak",
   "start": 16.295,
   "end": 18.095
  },
  {
   "scene": 5,
   "text": "เสียงขูดดังมาจากใต้เตียง",
   "style": "y",
   "start": 18.645,
   "end": 20.346
  },
  {
   "scene": 6,
   "text": "ข้อความที่สาม",
   "style": "n",
   "start": 21.746,
   "end": 22.78
  },
  {
   "scene": 6,
   "text": "ถ้ามันออกมา วิ่งไปห้องน้ำ แล้วล็อกประตู",
   "style": "y",
   "start": 23.33,
   "end": 25.723
  },
  {
   "scene": 7,
   "text": "แล้วมือดำๆ ก็โผล่ออกมา",
   "style": "r",
   "start": 26.823,
   "end": 28.497
  },
  {
   "scene": 8,
   "text": "คุณวิ่งสุดชีวิต เข้าห้องน้ำ ล็อกประตูแน่น",
   "style": "n",
   "start": 29.897,
   "end": 32.348
  },
  {
   "scene": 9,
   "text": "ปลอดภัยแล้ว",
   "style": "n",
   "start": 33.348,
   "end": 34.125
  },
  {
   "scene": 10,
   "text": "โทรศัพท์สั่นอีกครั้ง",
   "style": "n",
   "start": 36.325,
   "end": 37.493
  },
  {
   "scene": 10,
   "text": "ขอบคุณที่มาหาฉัน… ในห้องน้ำนะ",
   "style": "y",
   "start": 38.043,
   "end": 40.166
  },
  {
   "scene": 11,
   "text": "เจอกันแล้วนะ",
