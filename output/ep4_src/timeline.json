{
 "total": 59.646,
 "outro": 55.427,
 "chunks": [
  {
   "scene": 1,
   "text": "ถ้าคุณจ้องกระจกตอนดึกๆ",
   "style": "n",
   "start": 0.8,
   "end": 2.278
  },
  {
   "scene": 1,
   "text": "ลองกะพริบตาดูสักครั้ง",
   "style": "y",
   "start": 2.828,
   "end": 4.331
  },
  {
   "scene": 2,
   "text": "เพราะบางคืน คนในกระจก",
   "style": "n",
   "start": 5.131,
   "end": 6.488
  },
  {
   "scene": 2,
   "text": "ไม่กะพริบตาตามคุณ",
   "style": "r",
   "start": 7.038,
   "end": 8.276
  },
  {
   "scene": 3,
   "text": "คืนนั้น คุณแปรงฟันอยู่หน้ากระจก",
   "style": "n",
   "start": 9.676,
   "end": 11.531
  },
  {
   "scene": 4,
   "text": "คุณกะพริบตา",
   "style": "n",
   "start": 12.331,
   "end": 13.12
  },
  {
   "scene": 4,
   "text": "แต่คนในกระจก ยังลืมตาค้าง",
   "style": "y",
   "start": 13.67,
   "end": 15.579
  },
  {
   "scene": 5,
   "text": "คุณลองยิ้มให้ตัวเอง",
   "style": "n",
   "start": 16.979,
   "end": 18.259
  },
  {
   "scene": 5,
   "text": "มันก็ยิ้มตอบ แต่กว้างเกินไป",
   "style": "r",
   "start": 18.809,
   "end": 20.684
  },
  {
   "scene": 6,
   "text": "คุณค่อยๆ ถอยหลัง",
   "style": "n",
   "start": 22.384,
   "end": 23.536
  },
  {
   "scene": 6,
   "text": "แต่มัน ไม่ถอยตาม",
   "style": "y",
   "start": 24.086,
   "end": 25.111
  },
  {
   "scene": 7,
   "text": "มันยกมือขึ้น แตะกระจกจากด้านใน",
   "style": "r",
   "start": 26.611,
   "end": 28.739
  },
  {
   "scene": 8,
   "text": "แล้วเขียนบนไอน้ำว่า",
   "style": "n",
   "start": 30.739,
   "end": 32.121
  },
  {
   "scene": 9,
   "text": "ปล่อยฉันออกไป",
   "style": "x",
   "start": 32.921,
   "end": 34.808
  },
  {
   "scene": 10,
   "text": "คุณวิ่งออกจากห้องน้ำ ปิดประตูแน่น",
   "style": "n",
   "start": 37.008,
   "end": 39.029
  },
  {
   "scene": 11,
   "text": "เช้าวันต่อมา กระจกแตกละเอียด",
   "style": "y",
   "start": 40.229,
   "end": 41.866
  },
  {
   "scene": 11,
   "text": "และไม่มีใครอยู่ในนั้นแล้ว",
   "style": "n",
   "start": 42.416,
   "end": 43.962
  },
  {
   "scene": 12,
   "text": "คุณโล่งใจ หยิบมือถือขึ้นมาเซลฟี่",
   "style": "n",
   "start": 45.562,
   "end": 47.637
  },
  {
   "scene": 13,
   "text": "คนในกล้อง",
   "style": "n",
   "start": 48.437,
   "end": 49.054
  },
  {
   "scene": 13,
   "text": "ไม่กะพริบตา",
   "style": "r",
   "start": 49.604,
   "end": 50.427
  }
 ],
