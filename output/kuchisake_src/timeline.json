{
 "total": 73.567,
 "outro": 69.348,
 "chunks": [
  {
   "scene": 1,
   "text": "ถ้าคุณเดินกลับบ้านคนเดียวตอนค่ำที่ญี่ปุ่น",
   "style": "n",
   "start": 0.8,
   "end": 3.495
  },
  {
   "scene": 1,
   "text": "แล้วเจอผู้หญิงใส่หน้ากากอนามัย",
   "style": "y",
   "start": 4.045,
   "end": 5.992
  },
  {
   "scene": 2,
   "text": "อย่าตอบคำถามของเธอ",
   "style": "r",
   "start": 6.792,
   "end": 8.139
  },
  {
   "scene": 3,
   "text": "ตำนานนี้ชื่อ คุจิสะเกะอนนะ",
   "style": "y",
   "start": 9.539,
   "end": 11.093
  },
  {
   "scene": 3,
   "text": "ผู้หญิงปากฉีก",
   "style": "r",
   "start": 11.643,
   "end": 12.516
  },
  {
   "scene": 4,
   "text": "คืนนั้น ไฟถนนกะพริบ",
   "style": "n",
   "start": 13.916,
   "end": 15.179
  },
  {
   "scene": 4,
   "text": "มีผู้หญิงยืนอยู่ใต้เสาไฟ",
   "style": "y",
   "start": 15.729,
   "end": 17.482
  },
  {
   "scene": 5,
   "text": "เธอเดินเข้ามาหาคุณช้าๆ",
   "style": "n",
   "start": 18.282,
   "end": 19.955
  },
  {
   "scene": 5,
   "text": "แล้วถามเสียงแผ่วๆ",
   "style": "n",
   "start": 20.505,
   "end": 21.698
  },
  {
   "scene": 6,
   "text": "ฉันสวยไหม",
   "style": "f",
   "start": 22.498,
   "end": 23.566
  },
  {
   "scene": 7,
   "text": "คุณตอบไปว่า… สวยครับ",
   "style": "n",
   "start": 25.266,
   "end": 26.737
  },
  {
   "scene": 8,
   "text": "เธอค่อยๆ ดึงหน้ากากลง",
   "style": "y",
   "start": 28.037,
   "end": 29.443
  },
  {
   "scene": 9,
   "text": "ปากของเธอ ฉีกยาวไปถึงหู",
   "style": "r",
   "start": 30.843,
   "end": 32.722
  },
  {
   "scene": 10,
   "text": "แล้วแบบนี้ล่ะ… สวยไหม",
   "style": "x",
   "start": 34.422,
   "end": 36.846
  },
  {
   "scene": 11,
   "text": "ถ้าตอบว่าไม่สวย เธอจะฆ่าคุณ",
   "style": "r",
   "start": 38.646,
   "end": 40.608
  },
  {
   "scene": 11,
   "text": "ถ้าตอบว่าสวย เธอจะกรีดปากคุณให้เหมือนเธอ",
   "style": "y",
   "start": 41.158,
   "end": 43.848
  },
  {
   "scene": 12,
   "text": "แต่คนญี่ปุ่นเชื่อว่า มีทางรอดอยู่ทางเดียว",
   "style": "n",
   "start": 45.148,
   "end": 47.546
  },
  {
   "scene": 13,
   "text": "ตอบว่า ก็งั้นๆ",
   "style": "y",
   "start": 48.346,
   "end": 49.434
  },
  {
   "scene": 13,
   "text": "แล้ววิ่งหนีให้เร็วที่สุด",
   "style": "r",
   "start": 49.984,
   "end": 51.222
  },
  {
   "scene": 14,
   "text": "คุณทำตามนั้น วิ่งสุดชีวิตจนถึงบ้าน",
   "style": "n",
   "start": 52.022,
   "end": 54.374
  },
  {
   "scene": 15,
   "text": "หันกลับไปมอง ไม่มีใครตามมา",
   "style": "n",
   "start": 55.174,
   "end": 57.068
  },
  {
   "scene": 16,
   "text": "แต่ทันทีที่เปิดประตู เสียงนั้นดังมาจากในบ้าน",
   "style": "n",
   "start": 58.468,
   "end": 61.516
  },
  {
   "scene": 17,
   "text": "ก็งั้นๆ… เหรอ",
   "style": "x",
   "start": 62.716,
   "end": 64.348
  }
 ],
