 "chunks": [
  {
   "scene": 1,
   "text": "ถ้าคุณเดินกลับบ้านคนเดียว ริมทางรถไฟตอนดึก",
   "style": "n",
   "start": 0.8,
   "end": 3.922
  },
  {
   "scene": 1,
   "text": "แล้วได้ยินเสียงแบบนี้",
   "style": "y",
   "start": 4.472,
   "end": 5.934
  },
  {
   "scene": 2,
   "text": "เทเกะ… เทเกะ…",
   "style": "k",
   "sfx": "teke",
   "start": 6.934,
   "end": 9.334
  },
  {
   "scene": 3,
   "text": "อย่าหันกลับไปมอง",
   "style": "r",
   "start": 10.534,
   "end": 11.657
  },
  {
   "scene": 4,
   "text": "ตำนานญี่ปุ่น เทเกะ เทเกะ",
   "style": "y",
   "start": 13.057,
   "end": 14.488
  },
  {
   "scene": 4,
   "text": "ผีหญิงสาวที่ร่างขาดเป็นสองท่อน",
   "style": "r",
   "start": 15.038,
   "end": 17.193
  },
  {
   "scene": 5,
   "text": "เธอตกลงบนรางรถไฟ ในคืนที่หนาวจัด",
   "style": "n",
   "start": 18.593,
   "end": 20.913
  },
  {
   "scene": 5,
   "text": "ความเย็นทำให้เธอไม่ตายทันที",
   "style": "y",
   "start": 21.463,
   "end": 23.385
  },
  {
   "scene": 6,
   "text": "เธอคลานหาขาของตัวเอง ด้วยข้อศอก",
   "style": "n",
   "start": 24.585,
   "end": 26.568
  },
  {
   "scene": 7,
   "text": "คืนนั้น ไม้กั้นทางรถไฟลงมา ไฟแดงกะพริบ",
   "style": "n",
   "start": 27.368,
   "end": 29.932
  },
  {
   "scene": 7,
   "text": "แต่ไม่มีรถไฟผ่านมาเลย",
   "style": "y",
   "start": 30.482,
   "end": 32.018
  },
  {
   "scene": 8,
   "text": "แล้วเสียงนั้น ก็ดังขึ้นข้างหลังคุณ",
   "style": "n",
   "start": 33.418,
   "end": 35.497
  },
  {
   "scene": 8,
   "text": "เทเกะ เทเกะ",
   "style": "k",
   "sfx": "teke",
   "start": 36.047,
   "end": 38.447
  },
  {
   "scene": 9,
   "text": "คุณเผลอหันไปมอง",
   "style": "r",
   "start": 39.447,
   "end": 40.584
  },
  {
   "scene": 10,
   "text": "ร่างครึ่งตัว กำลังคลานเข้ามา",
   "style": "y",
   "start": 41.984,
   "end": 43.751
  },
  {
   "scene": 10,
   "text": "เร็วมาก",
   "style": "r",
   "start": 44.301,
   "end": 44.777
  },
  {
   "scene": 11,
   "text": "คุณวิ่งสุดชีวิต",
   "style": "n",
   "start": 45.577,
   "end": 46.502
  },
  {
   "scene": 11,
   "text": "แต่เสียงนั้น เร็วกว่า",
   "style": "r",
   "start": 47.052,
   "end": 48.204
  },
  {
   "scene": 12,
   "text": "ขาของฉัน… อยู่ไหน",
