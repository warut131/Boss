 "outro": 69.362,
 "chunks": [
  {
   "scene": 1,
   "text": "ที่โรงเรียนในญี่ปุ่น มีกฎที่เด็กทุกคนรู้",
   "style": "n",
   "start": 0.8,
   "end": 3.407
  },
  {
   "scene": 1,
   "text": "ห้ามเคาะห้องน้ำชั้นสาม ห้องที่สาม",
   "style": "r",
   "start": 3.957,
   "end": 6.052
  },
  {
   "scene": 2,
   "text": "ตำนานนี้ชื่อ ฮานาโกะซัง",
   "style": "y",
   "start": 7.152,
   "end": 8.653
  },
  {
   "scene": 2,
   "text": "ผีเด็กผู้หญิงในห้องน้ำ",
   "style": "r",
   "start": 9.203,
   "end": 10.638
  },
  {
   "scene": 3,
   "text": "ว่ากันว่า ถ้าเคาะประตูสามครั้ง แล้วเรียกชื่อเธอ",
   "style": "n",
   "start": 12.038,
   "end": 14.858
  },
  {
   "scene": 3,
   "text": "เธอจะตอบกลับมา",
   "style": "y",
   "start": 15.408,
   "end": 16.517
  },
  {
   "scene": 4,
   "text": "วันนั้น เพื่อนท้าให้คุณลอง",
   "style": "n",
   "start": 17.717,
   "end": 19.271
  },
  {
   "scene": 4,
   "text": "หลังเลิกเรียน ตอนที่โรงเรียนเงียบสนิท",
   "style": "n",
   "start": 19.821,
   "end": 21.743
  },
  {
   "scene": 5,
   "text": "คุณเดินเข้าห้องน้ำชั้นสาม",
   "style": "n",
   "start": 22.543,
   "end": 24.173
  },
  {
   "scene": 5,
   "text": "ไฟกะพริบ",
   "style": "y",
   "start": 24.723,
   "end": 25.215
  },
  {
   "scene": 6,
   "text": "คุณเคาะประตูห้องที่สาม",
   "style": "n",
   "start": 26.015,
   "end": 27.5
  },
  {
   "scene": 6,
   "text": "ก๊อก… ก๊อก… ก๊อก…",
   "style": "k",
   "sfx": "knock",
   "start": 28.05,
   "end": 30.05
  },
  {
   "scene": 7,
   "text": "ฮานาโกะซัง… อยู่ไหมครับ",
   "style": "n",
   "start": 31.15,
   "end": 32.615
  },
  {
   "scene": 8,
   "text": "เงียบ",
   "style": "n",
   "start": 34.015,
   "end": 34.291
  },
  {
   "scene": 9,
   "text": "คุณหัวเราะ แล้วหันหลังจะเดินออกไป",
   "style": "n",
   "start": 36.491,
   "end": 38.508
  },
  {
   "scene": 10,
   "text": "อยู่จ้ะ",
   "style": "c",
   "start": 39.508,
   "end": 40.317
  },
  {
   "scene": 11,
   "text": "ประตูห้องที่สาม ค่อยๆ เปิดออก",
   "style": "y",
   "start": 42.117,
   "end": 43.927
  },
  {
   "scene": 12,
   "text": "มือเล็กๆ สีขาวซีด ยื่นออกมาคว้าข้อเท้าคุณ",
   "style": "r",
   "start": 45.327,
   "end": 48.108
  },
  {
   "scene": 13,
   "text": "เพื่อนคุณรออยู่หน้าห้องน้ำจนมืด",
   "style": "n",
   "start": 49.708,
   "end": 51.697
  },
  {
   "scene": 13,
   "text": "แต่คุณไม่เคยเดินออกมาอีกเลย",
   "style": "r",
   "start": 52.247,
   "end": 53.984
  },
  {
   "scene": 14,
   "text": "ตั้งแต่วันนั้น ถ้ามีใครเคาะห้องที่สาม",
   "style": "n",
   "start": 55.384,
   "end": 57.764
  },
  {
   "scene": 14,
   "text": "ก๊อก… ก๊อก… ก๊อก…",
   "style": "k",
   "sfx": "knock",
   "start": 58.314,
   "end": 60.314
  },
  {
   "scene": 14,
   "text": "จะมีเสียงผู้ชายตอบกลับมาว่า",
   "style": "y",
   "start": 60.864,
   "end": 62.792
  },
  {
   "scene": 15,
   "text": "อยู่ครับ",
