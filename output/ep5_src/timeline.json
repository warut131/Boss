 "chunks": [
  {
   "scene": 1,
   "text": "ตึกนี้… ไม่มีชั้นสิบสาม",
   "style": "n",
   "start": 0.8,
   "end": 2.473
  },
  {
   "scene": 2,
   "text": "แต่คืนนั้น ลิฟต์ดันไปหยุดที่ชั้นสิบสาม",
   "style": "r",
   "start": 3.273,
   "end": 5.692
  },
  {
   "scene": 3,
   "text": "คุณกลับจากทำงานดึก กดชั้นสิบสอง",
   "style": "n",
   "start": 7.092,
   "end": 9.478
  },
  {
   "scene": 4,
   "text": "ไฟในลิฟต์กะพริบ",
   "style": "n",
   "start": 10.278,
   "end": 11.093
  },
  {
   "scene": 4,
   "text": "ตัวเลขขึ้นไปเรื่อยๆ",
   "style": "y",
   "start": 11.643,
   "end": 12.882
  },
  {
   "scene": 5,
   "text": "ติ๊ง",
   "style": "k",
   "sfx": "ding",
   "start": 14.082,
   "end": 15.682
  },
  {
   "scene": 5,
   "text": "ประตูเปิดออก ทางเดินมืดสนิท",
   "style": "n",
   "start": 16.232,
   "end": 17.877
  },
  {
   "scene": 6,
   "text": "มีผู้หญิงผมยาว ยืนหันหลังอยู่ปลายทางเดิน",
   "style": "y",
   "start": 18.677,
   "end": 21.364
  },
  {
   "scene": 7,
   "text": "คุณรัวปุ่มปิดประตู",
   "style": "n",
   "start": 22.964,
   "end": 24.228
  },
  {
   "scene": 7,
   "text": "แต่ประตูไม่ยอมปิด",
   "style": "r",
   "start": 24.778,
   "end": 25.81
  },
  {
   "scene": 8,
   "text": "ผู้หญิงคนนั้น ค่อยๆ เดินถอยหลังเข้ามา",
   "style": "y",
   "start": 27.21,
   "end": 29.592
  },
  {
   "scene": 9,
   "text": "ใกล้ขึ้น",
   "style": "n",
   "start": 30.992,
   "end": 31.562
  },
  {
   "scene": 9,
   "text": "ใกล้ขึ้นอีก",
   "style": "r",
   "start": 32.112,
   "end": 32.718
  },
  {
   "scene": 10,
   "text": "ประตูปิดลงทันเวลา ลิฟต์ดิ่งลงไปชั้นหนึ่ง",
   "style": "n",
   "start": 34.318,
   "end": 36.953
  },
  {
   "scene": 11,
   "text": "ติ๊ง",
   "style": "k",
   "sfx": "ding",
   "start": 38.353,
   "end": 39.753
  },
  {
   "scene": 11,
   "text": "คุณถอนหายใจโล่งอก",
   "style": "n",
   "start": 40.303,
   "end": 41.601
  },
  {
   "scene": 12,
   "text": "แต่ในกระจกลิฟต์ ด้านหลังคุณ",
   "style": "n",
   "start": 42.401,
   "end": 43.973
  },
  {
   "scene": 12,
   "text": "มีผมยาวสีดำ พาดอยู่บนไหล่",
   "style": "r",
   "start": 44.523,
   "end": 46.444
  },
  {
   "scene": 13,
   "text": "ขอลงด้วยคนนะ",
   "style": "x",
   "start": 48.044,
   "end": 49.819
  }
 ],
