{
 "total": 65.225,
 "outro": 61.006,
 "chunks": [
  {
   "scene": 1,
   "text": "ตอนที่แล้ว มีใครบางคน นับเลขต่อจากคุณในความมืด",
   "style": "n",
   "start": 0.8,
   "end": 3.842
  },
  {
   "scene": 2,
   "text": "ไฟกลับมาติด",
   "style": "n",
   "start": 4.642,
   "end": 5.41
  },
  {
   "scene": 2,
   "text": "ไม่มีใครอยู่ในห้อง",
   "style": "y",
   "start": 5.96,
   "end": 7.08
  },
  {
   "scene": 3,
   "text": "แต่ใต้เตียง มีกระดาษแผ่นหนึ่ง",
   "style": "n",
   "start": 8.38,
   "end": 9.935
  },
  {
   "scene": 3,
   "text": "กฎข้อเจ็ด ที่หายไป",
   "style": "r",
   "start": 10.485,
   "end": 11.837
  },
  {
   "scene": 4,
   "text": "ถ้าคุณจำไม่ได้ ว่าย้ายเข้ามาวันไหน",
   "style": "y",
   "start": 13.237,
   "end": 15.511
  },
  {
   "scene": 4,
   "text": "ให้หนีออกจากที่นี่ทันที",
   "style": "r",
   "start": 16.061,
   "end": 17.667
  },
  {
   "scene": 5,
   "text": "คุณพยายามนึก",
   "style": "n",
   "start": 19.067,
   "end": 19.92
  },
  {
   "scene": 5,
   "text": "แต่นึกไม่ออกเลย",
   "style": "y",
   "start": 20.47,
   "end": 21.492
  },
  {
   "scene": 6,
   "text": "คุณคว้ากระเป๋า วิ่งลงบันได",
   "style": "n",
   "start": 22.892,
   "end": 24.483
  },
  {
   "scene": 7,
   "text": "ป้าเจ้าของหอ ยืนรออยู่ข้างล่าง",
   "style": "n",
   "start": 25.283,
   "end": 27.28
  },
  {
   "scene": 8,
   "text": "หนูเป็นใครจ๊ะ",
   "style": "f",
   "start": 28.48,
   "end": 29.512
  },
  {
   "scene": 8,
   "text": "ห้องสี่ศูนย์สาม ว่างมาสิบปีแล้วนะ",
   "style": "f",
   "start": 30.062,
   "end": 32.382
  },
  {
   "scene": 9,
   "text": "คุณก้มมองมือตัวเอง",
   "style": "n",
   "start": 33.982,
   "end": 35.29
  },
  {
   "scene": 9,
   "text": "มันโปร่งแสง",
   "style": "r",
   "start": 35.84,
   "end": 36.771
  },
  {
   "scene": 10,
   "text": "วันต่อมา มีผู้เช่าคนใหม่ย้ายเข้ามา",
   "style": "n",
   "start": 38.571,
   "end": 41.137
  },
  {
   "scene": 10,
   "text": "ป้ายื่นกฎเจ็ดข้อให้เขา",
   "style": "n",
   "start": 41.687,
   "end": 43.204
  },
  {
   "scene": 11,
   "text": "กฎข้อเจ็ด",
   "style": "n",
   "start": 44.004,
   "end": 44.553
  },
  {
   "scene": 11,
   "text": "เป็นลายมือของคุณ",
   "style": "y",
   "start": 45.103,
   "end": 46.083
  },
  {
   "scene": 12,
   "text": "ตีสองสิบนาที",
   "style": "n",
   "start": 47.683,
   "end": 48.811
  },
  {
   "scene": 12,
   "text": "ก๊อก… ก๊อก… ก๊อก…",
   "style": "k",
   "sfx": "knock",
   "start": 49.361,
   "end": 51.361
  },
  {
   "scene": 12,
   "text": "คุณยืนเคาะประตูห้องเขา",
   "style": "r",
   "start": 51.911,
   "end": 53.334
  },
  {
