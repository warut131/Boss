 "chunks": [
  {
   "scene": 1,
   "text": "ตอนที่แล้ว คุณมองผ่านตาแมว",
   "style": "n",
   "start": 0.8,
   "end": 2.508
  },
  {
   "scene": 1,
   "text": "แล้วเจอลูกตาจ้องกลับมา",
   "style": "r",
   "start": 3.058,
   "end": 4.607
  },
  {
   "scene": 2,
   "text": "เช้าวันต่อมา คุณลงไปถามป้าเจ้าของหอ",
   "style": "n",
   "start": 5.807,
   "end": 8.354
  },
  {
   "scene": 3,
   "text": "ป้าหน้าซีดเผือด",
   "style": "n",
   "start": 9.154,
   "end": 10.019
  },
  {
   "scene": 3,
   "text": "ป้าไม่เคยขึ้นไปชั้นสี่ ตอนกลางคืนเลยนะ",
   "style": "f",
   "start": 10.569,
   "end": 13.238
  },
  {
   "scene": 4,
   "text": "แล้วห้องข้างๆ ล่ะครับ",
   "style": "n",
   "start": 14.638,
   "end": 15.919
  },
  {
   "scene": 4,
   "text": "ห้องสี่ศูนย์สี่ ว่างมาสิบปีแล้ว",
   "style": "f",
   "start": 16.469,
   "end": 18.769
  },
  {
   "scene": 5,
   "text": "คืนนั้น คุณอ่านกฎอีกรอบ",
   "style": "n",
   "start": 20.369,
   "end": 21.995
  },
  {
   "scene": 5,
   "text": "ข้อห้า ถ้าไฟดับ ให้นับเลขดังๆ จนถึงเจ็ด",
   "style": "r",
   "start": 22.545,
   "end": 25.159
  },
  {
   "scene": 6,
   "text": "เที่ยงคืนตรง",
   "style": "n",
   "start": 26.559,
   "end": 27.337
  },
  {
   "scene": 6,
   "text": "ไฟดับทั้งตึก",
   "style": "y",
   "start": 27.887,
   "end": 28.618
  },
  {
   "scene": 7,
   "text": "หนึ่ง… สอง… สาม…",
   "style": "n",
   "start": 30.218,
   "end": 31.597
  },
  {
   "scene": 7,
   "text": "สี่… ห้า… หก…",
   "style": "n",
   "start": 32.147,
   "end": 33.206
  },
  {
   "scene": 7,
   "text": "เจ็ด",
   "style": "n",
   "start": 33.756,
   "end": 33.9
  },
  {
   "scene": 8,
   "text": "แปด",
   "style": "x",
   "start": 35.9,
   "end": 36.631
  },
  {
   "scene": 9,
   "text": "มีอีกเสียงหนึ่ง นับต่อจากคุณ",
   "style": "r",
   "start": 38.431,
   "end": 40.127
  },
  {
   "scene": 10,
   "text": "เก้า",
   "style": "x",
   "start": 41.527,
   "end": 42.44
  },
  {
   "scene": 10,
   "text": "สิบ",
   "style": "x",
   "start": 42.99,
   "end": 43.542
  },
  {
   "scene": 11,
   "text": "เสียงนั้น อยู่ข้างหลังคุณ",
   "style": "y",
   "start": 45.142,
   "end": 46.577
  },
  {
