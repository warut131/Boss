 "chunks": [
  {
   "scene": 1,
   "text": "ห้องเช่าเดือนละพันห้า กลางเมือง",
   "style": "n",
   "start": 0.8,
   "end": 2.534
  },
  {
   "scene": 1,
   "text": "ถูกจนน่าสงสัย",
   "style": "y",
   "start": 3.084,
   "end": 4.242
  },
  {
   "scene": 2,
   "text": "แต่มีเงื่อนไข ต้องทำตามกฎเจ็ดข้อ",
   "style": "r",
   "start": 5.042,
   "end": 7.37
  },
  {
   "scene": 3,
   "text": "ป้าเจ้าของหอยื่นกระดาษให้คุณ",
   "style": "n",
   "start": 8.67,
   "end": 10.464
  },
  {
   "scene": 3,
   "text": "กฎข้อเจ็ด ถูกฉีกหายไป",
   "style": "y",
   "start": 11.014,
   "end": 12.634
  },
  {
   "scene": 4,
   "text": "ข้อหนึ่ง กลับห้องก่อนเที่ยงคืน",
   "style": "n",
   "start": 13.834,
   "end": 15.425
  },
  {
   "scene": 4,
   "text": "ข้อสอง ถ้ามีคนเคาะประตู ห้ามเปิด",
   "style": "y",
   "start": 15.975,
   "end": 17.912
  },
  {
   "scene": 4,
   "text": "ข้อสาม ห้ามมองตาแมว หลังตีสอง",
   "style": "r",
   "start": 18.462,
   "end": 20.741
  },
  {
   "scene": 5,
   "text": "คืนแรก ทุกอย่างปกติ",
   "style": "n",
   "start": 22.141,
   "end": 23.362
  },
  {
   "scene": 6,
   "text": "จนตีสองสิบนาที",
   "style": "n",
   "start": 24.162,
   "end": 25.51
  },
  {
   "scene": 6,
   "text": "ก๊อก… ก๊อก… ก๊อก…",
   "style": "k",
   "sfx": "knock",
   "start": 26.06,
   "end": 28.06
  },
  {
   "scene": 7,
   "text": "หนูจ๋า ป้าเองนะ เปิดประตูหน่อย",
   "style": "m",
   "start": 28.86,
   "end": 31.251
  },
  {
   "scene": 8,
   "text": "เสียงเหมือนป้าเจ้าของหอทุกอย่าง",
   "style": "n",
   "start": 32.651,
   "end": 34.364
  },
  {
   "scene": 8,
   "text": "แต่คุณจำกฎข้อสองได้",
   "style": "y",
   "start": 34.914,
   "end": 36.51
  },
  {
   "scene": 9,
   "text": "เสียงเคาะ ดังขึ้นเรื่อยๆ",
   "style": "r",
   "start": 37.31,
   "end": 38.674
  },
  {
   "scene": 9,
   "text": "ก๊อก ก๊อก ก๊อก",
   "style": "k",
   "sfx": "knock",
   "start": 39.224,
   "end": 41.224
  },
  {
   "scene": 10,
   "text": "แล้วก็เงียบ",
   "style": "n",
   "start": 42.424,
   "end": 43.124
  },
  {
   "scene": 11,
   "text": "ความอยากรู้ชนะ",
   "style": "n",
   "start": 45.524,
   "end": 46.42
  },
  {
   "scene": 11,
   "text": "คุณค่อยๆ มองผ่านตาแมว",
   "style": "y",
   "start": 46.97,
   "end": 48.514
  },
  {
   "scene": 12,
   "text": "ทางเดินว่างเปล่า",
   "style": "n",
   "start": 49.714,
   "end": 50.626
  },
  {
