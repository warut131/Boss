{
 "total": 59.571,
 "outro": 55.352,
 "chunks": [
  {
   "scene": 1,
   "text": "ถ้าตุ๊กตาในห้องคุณ ไม่ได้อยู่ที่เดิม",
   "style": "n",
   "start": 0.8,
   "end": 2.922
  },
  {
   "scene": 1,
   "text": "อย่าทักมัน",
   "style": "r",
   "start": 3.472,
   "end": 4.213
  },
  {
   "scene": 2,
   "text": "คุณซื้อตุ๊กตาหมีมือสอง มาจากตลาดนัด",
   "style": "n",
   "start": 5.313,
   "end": 7.653
  },
  {
   "scene": 3,
   "text": "คืนแรก คุณวางมันไว้บนชั้น",
   "style": "n",
   "start": 8.453,
   "end": 10.245
  },
  {
   "scene": 4,
   "text": "เช้ามา มันนั่งอยู่บนโต๊ะ",
   "style": "y",
   "start": 11.045,
   "end": 12.449
  },
  {
   "scene": 5,
   "text": "คืนที่สอง คุณเอาไปไว้นอกห้อง",
   "style": "n",
   "start": 13.849,
   "end": 15.753
  },
  {
   "scene": 5,
   "text": "เช้ามา มันนอนอยู่ข้างหมอนคุณ",
   "style": "r",
   "start": 16.303,
   "end": 18.117
  },
  {
   "scene": 6,
   "text": "คุณเลยตั้งกล้อง ถ่ายไว้ทั้งคืน",
   "style": "n",
   "start": 19.517,
   "end": 21.246
  },
  {
   "scene": 7,
   "text": "ตีสามสิบเจ็ดนาที ในวิดีโอ",
   "style": "n",
   "start": 22.046,
   "end": 24.15
  },
  {
   "scene": 7,
   "text": "ตุ๊กตาค่อยๆ หันมามองกล้อง",
   "style": "r",
   "start": 24.7,
   "end": 26.436
  },
  {
   "scene": 8,
   "text": "แล้วมันก็ลุกขึ้น เดินไปที่เตียงคุณ",
   "style": "y",
   "start": 28.136,
   "end": 30.083
  },
  {
   "scene": 9,
   "text": "ก้มลงกระซิบข้างหูคุณ ที่กำลังหลับ",
   "style": "n",
   "start": 31.483,
   "end": 33.526
  },
  {
   "scene": 10,
   "text": "คุณเร่งเสียงจนสุด",
   "style": "n",
   "start": 34.926,
   "end": 36.055
  },
  {
   "scene": 11,
   "text": "คืนนี้… ตาเธอเป็นตุ๊กตาบ้างนะ",
   "style": "x",
   "start": 37.255,
   "end": 40.522
  },
  {
   "scene": 12,
   "text": "คุณหันไปมองตุ๊กตา",
   "style": "n",
   "start": 42.722,
   "end": 43.991
  },
  {
   "scene": 12,
   "text": "มันหายไปแล้ว",
   "style": "y",
   "start": 44.541,
   "end": 45.446
  },
  {
   "scene": 13,
   "text": "แต่พอคุณมองกระจก",
   "style": "n",
   "start": 46.846,
   "end": 47.971
  },
  {
   "scene": 13,
   "text": "ตาของคุณ กลายเป็นกระดุมสีดำ",
   "style": "r",
   "start": 48.521,
   "end": 50.352
  }
 ],
